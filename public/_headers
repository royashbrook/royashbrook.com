# craft rush moved to craftrush.royashbrook.com, and what is left here is the handover page that
# carries a player's save across to it. that page must never be cached: a returning player getting a
# stale copy is one that either sends them nowhere or, worse, replays a handover that already ran.
# it stays indefinitely, because someone opening an old bookmark next year should still be carried.
/craftrush
  Cache-Control: no-store
/craftrush/
  Cache-Control: no-store
/craftrush/index.html
  Cache-Control: no-store
/craftrush/service-worker.js
  Cache-Control: no-cache
/craftrush/sw.js
  Cache-Control: no-cache

# quantamari moved to quantamari.royashbrook.com. this old-path redirect and its worker tombstones
# must never become stale: returning players should always reach the current home, while retirement
# cleanup remains scoped to quantamari's own old worker and caches.
/quarkatamari
  Cache-Control: no-store
/quarkatamari/
  Cache-Control: no-store
/quarkatamari/index.html
  Cache-Control: no-store
/quarkatamari/service-worker.js
  Cache-Control: no-cache
/quarkatamari/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
