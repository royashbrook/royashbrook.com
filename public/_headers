# craft rush moved to craftrush.royashbrook.com, and what is left here is the handover page that
# carries a player's save across to it. that page must never be cached: a returning player getting a
# stale copy is one that either sends them nowhere or, worse, replays a handover that already ran.
# it stays indefinitely, because someone opening an old bookmark next year should still be carried.
/craftrush
  Cache-Control: no-store
/craftrush/
  Cache-Control: no-store
/craftrush/index.html
  Cache-Control: no-store

# quantamari moved to quantamari.royashbrook.com, and what is left here is the handover page that
# carries a player's save across to it. same reasoning as /craftrush above: a returning player must
# never get a cached copy, which would either send them nowhere or replay a handoff that already ran.
/quarkatamari
  Cache-Control: no-store
/quarkatamari/
  Cache-Control: no-store
/quarkatamari/index.html
  Cache-Control: no-store

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
