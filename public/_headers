# craft rush moved to craftrush.royashbrook.com, and what is left here is the handover page that
# carries a player's save across to it. that page must never be cached: a returning player getting a
# stale copy is one that either sends them nowhere or, worse, replays a handover that already ran.
# it stays indefinitely, because someone opening an old bookmark next year should still be carried.
/craftrush
  Cache-Control: no-store
/craftrush/
  Cache-Control: no-store
/craftrush/index.html
  Cache-Control: no-store
/craftrush/service-worker.js
  Cache-Control: no-cache
/craftrush/sw.js
  Cache-Control: no-cache

# Quarkatamari's stable shell/PWA metadata must revalidate on every online load.
/quarkatamari
  Cache-Control: no-store
/quarkatamari/
  Cache-Control: no-store
/quarkatamari/index.html
  Cache-Control: no-store
/quarkatamari/service-worker.js
  Cache-Control: no-cache
/quarkatamari/manifest.webmanifest
  Cache-Control: no-cache
/quarkatamari/_app/version.json
  Cache-Control: no-cache

# SvelteKit fingerprints immutable bundles. Browser caching also prevents the service worker's
# install-time cache.addAll from downloading a chunk the page just fetched.
/quarkatamari/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
