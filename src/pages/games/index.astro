---
import Cards from '../../components/Cards.astro';
import Base from '../../layouts/Base.astro';
import { games, gameLinkOrder } from '../../data/games.js';
---
<Base title="games — roy ashbrook">
  <section>
    <h1 class="marker">&gt; games</h1>
    <p class="note">small browser games, free forever. no ads, no lives, no timers, nothing to buy, no accounts, no cookies, nothing sold or shared. each one installs to your phone and plays offline.</p>
    <Cards items={games} links={gameLinkOrder} />
  </section>
</Base>
