---
import Base from '../../layouts/Base.astro';
import { skills as tools, skillLinkOrder as linkOrder } from '../../data/skills.js';

// the human-facing skills shelf, from the one combined registry (skills.js): the github-topic
// auto-discovery plus the adapters for skills that live inside product repos or other orgs.
---
<Base title="skills — roy ashbrook">
  <section>
    <p class="marker">&gt; skills</p>
    <p class="note">drop-in skills for ai agents. clone one into your agent's skills folder, or point at the mcp endpoint. free, open source, no accounts.</p>
    <div class="cards">
      {tools.map((t) => (
        <div class="card">
          <div class="t">{t.name}</div>
          <div class="d">{t.desc}</div>
          <div class="meta">{linkOrder.filter((k) => t[k]).map((k, i) => (<>{i > 0 ? ' · ' : ''}<a href={t[k]}>{k}</a></>))}</div>
        </div>
      ))}
    </div>
  </section>
</Base>
