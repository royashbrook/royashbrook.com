---
// The handover page for Craft Rush's move to its own address.
//
// WHY A PAGE AND NOT A 301. A redirect would move everyone and strand their save.
// Game progress lives in localStorage, which is scoped to an ORIGIN, and a
// different hostname is a different origin. Nothing reads across that line any
// more: the old hidden-iframe handoff is dead, because Safari's ITP and Chrome's
// storage partitioning each hand a third-party frame its own empty box. The only
// mechanism left is a FIRST-PARTY read, which is what this page is: it runs on the
// OLD origin, reads its own storage, and passes the bytes along in a URL fragment.
//
// A fragment rather than a query string, because fragments are never sent to a
// server, so nobody's save ends up in a log.
//
// It sends the game's own `CR1|` transfer code, the same thing the in-game export
// produces, so the new origin runs the import path it already had tested instead
// of a bespoke one written for a move that happens once. The portable code also
// survives iOS's second boundary: Safari and a Home Screen app do not share
// localStorage, so a player must retain a copy until the installed app restores it.
//
// This page is deliberately standalone: no site layout, no shared CSS, no analytics
// beacon. It is a doorway, and it has to work on a device we cannot test, holding a
// kid's saved game. It stays until the traffic stops, not for some fixed window: a
// player who opens it a year from now still gets carried over.
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#17141d" />
<meta name="robots" content="noindex" />
<link rel="canonical" href="https://craftrush.royashbrook.com/" />
<title>Craft Rush has moved</title>
<style>
  html, body { margin: 0; height: 100%; }
  body { background: #17141d; color: #fff; display: flex; align-items: center;
    justify-content: center; padding: 20px; text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; line-height: 1.6; }
  .box { max-width: 430px; }
  h1 { font-size: 18px; letter-spacing: 1px; margin: 0 0 12px; color: #7ee0ff; }
  p { font-size: 14px; margin: 0 0 14px; }
  .dim { color: #9a92ad; font-size: 12px; }
  .warning { color: #ffd36a; font-weight: 700; }
  a.go { display: inline-block; font-weight: 700; text-decoration: none;
    padding: 12px 18px; background: #4a8f2f; color: #fff; border: 2px solid #000; }
  .recovery { margin: 18px 0; padding: 14px; border: 1px solid #51495e;
    background: #211d29; text-align: left; }
  .recovery p { font-size: 12px; }
  textarea { box-sizing: border-box; width: 100%; min-height: 110px; resize: vertical;
    margin: 0 0 10px; padding: 8px; border: 1px solid #70677d; background: #110f15;
    color: #fff; font: 11px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  button, a.download { display: inline-block; margin: 0 4px 4px 0; padding: 8px 10px;
    border: 1px solid #000; background: #7ee0ff; color: #17141d; font: inherit;
    font-size: 12px; font-weight: 700; text-decoration: none; cursor: pointer; }
  .confirm { display: flex; align-items: flex-start; gap: 8px; margin: 10px 0 4px;
    color: #ffd36a; font-size: 11px; font-weight: 700; cursor: pointer; }
  .confirm input { flex: 0 0 auto; width: 20px; height: 20px; margin: 0; }
</style>
</head>
<body>
<div class="box">
  <h1>CRAFT RUSH HAS A NEW HOME</h1>
  <p id="msg">Checking for your saved game&hellip;</p>
  <div class="recovery" id="recovery" hidden>
    <p class="warning">KEEP THIS OLD APP until the new installed app shows your
      emeralds and progress.</p>
    <p>iPhone keeps this app, Safari, and the new Home Screen app in separate
      storage. Copy or download the code first. After installing the new app,
      open it and tap <strong>RESTORE COPIED SAVE</strong>.</p>
    <textarea id="saveCode" readonly aria-label="Craft Rush save code"></textarea>
    <button id="copySave" type="button">COPY SAVE CODE</button>
    <a class="download" id="downloadSave" download="craft-rush-save.txt">DOWNLOAD SAVE CODE</a>
    <label class="confirm">
      <input id="backupConfirm" type="checkbox" />
      I HAVE COPIED OR SAVED THIS CODE OUTSIDE THE OLD APP
    </label>
    <p class="dim" id="copyStatus" role="status"></p>
  </div>
  <p><a class="go" id="go" href="https://craftrush.royashbrook.com/">OPEN NEW HOME</a></p>
  <p class="dim" id="note"></p>
</div>

<script is:inline>
/*
  Inline, dependency free, and defensive at every step. Nothing automatically
  navigates away. A player with a save must first make a portable copy, because
  the fragment handoff reaches Safari but a later Home Screen install does not
  inherit Safari localStorage. Nothing here deletes a save.
*/
(function () {
  var NEW_ORIGIN = 'https://craftrush.royashbrook.com/';
  var SAVE_KEY = 'craftrush_save_v1';
  var BACKUP_KEY = 'craftrush_backups_v1';
  // About what a URL fragment carries safely across browsers. A save this large
  // means something unusual, and a truncated payload is worse than none at all.
  var MAX_PAYLOAD = 60000;

  var msg = document.getElementById('msg');
  var note = document.getElementById('note');
  var go = document.getElementById('go');
  var recovery = document.getElementById('recovery');
  var saveCodeField = document.getElementById('saveCode');
  var copySave = document.getElementById('copySave');
  var downloadSave = document.getElementById('downloadSave');
  var backupConfirm = document.getElementById('backupConfirm');
  var copyStatus = document.getElementById('copyStatus');

  function b64(str) { return btoa(unescape(encodeURIComponent(str))); }
  function b64url(str) {
    return b64(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function read(key) {
    try { return localStorage.getItem(key); } catch (e) { return null; }
  }

  var url = NEW_ORIGIN;
  var carried = false;
  var saveCode = '';
  var clipboardReady = false;
  var manualBackupReady = false;
  var hadSave = !!read(SAVE_KEY);
  try {
    var raw = read(SAVE_KEY);
    if (raw) {
      // Two encodings on purpose. The INNER one is plain base64 with a CR1|
      // prefix, because that is the exact format the game's importSave() reads.
      // The OUTER one is base64url, because the whole thing has to survive being
      // a URL fragment.
      saveCode = 'CR1|' + b64(raw);
      var payload = { s: saveCode };
      var backups = read(BACKUP_KEY);
      if (backups) {
        try { payload.b = JSON.parse(backups); } catch (e) { /* bonus only */ }
      }
      var frag = b64url(JSON.stringify(payload));
      if (frag.length <= MAX_PAYLOAD) {
        url = NEW_ORIGIN + '#cr-migrate=' + frag;
        carried = true;
      }
    }
  } catch (e) { /* fall through to a plain move */ }

  go.href = url;
  function selectAndCopy() {
    saveCodeField.focus();
    saveCodeField.select();
    try {
      return document.execCommand('copy');
    } catch (e) {
      return false;
    }
  }

  function copyPortableSave() {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(saveCode).then(function () {
        return true;
      }).catch(selectAndCopy);
    }
    return Promise.resolve(selectAndCopy());
  }

  function markCopied(ok) {
    clipboardReady = ok;
    copyStatus.textContent = ok
      ? 'Save code copied. Keep it until the new app shows your progress.'
      : 'Your save has NOT been copied. Select the code above, copy it, or download the file.';
    return ok;
  }

  function openNewHome() {
    // Do not retire the old worker or its caches here. Until the replacement
    // install restores and verifies the save, this old icon is the last rescue
    // copy and must remain reopenable, including offline.
    location.assign(url);
  }

  if (hadSave && saveCode) {
    msg.textContent = 'Back up your save before opening the new home';
    recovery.hidden = false;
    saveCodeField.value = saveCode;
    go.textContent = 'COPY SAVE & OPEN NEW HOME';
    note.textContent = carried
      ? 'The browser handoff is ready too, but keep the copied code for the new Home Screen app.'
      : 'This save is too large for a browser handoff. Restore the copied code in the new app.';

    copySave.addEventListener('click', function () {
      copyPortableSave().then(markCopied);
    });

    go.addEventListener('click', function (event) {
      event.preventDefault();
      if (clipboardReady || manualBackupReady) {
        openNewHome();
        return;
      }
      copyStatus.textContent = 'Copying your save before opening the new home…';
      copyPortableSave().then(function (ok) {
        if (markCopied(ok)) openNewHome();
      });
    });

    try {
      downloadSave.href = URL.createObjectURL(
        new Blob([saveCode], { type: 'text/plain;charset=utf-8' }),
      );
    } catch (e) {
      downloadSave.hidden = true;
    }
    downloadSave.addEventListener('click', function () {
      copyStatus.textContent = 'If the file appeared in Files, check the box below before continuing.';
    });
    backupConfirm.addEventListener('change', function () {
      manualBackupReady = backupConfirm.checked;
      copyStatus.textContent = manualBackupReady
        ? 'Backup confirmed. Keep it until the new app shows your progress.'
        : 'Confirm the code is outside this old app before continuing.';
    });
  } else if (hadSave) {
    msg.textContent = 'Your save is still here, but this page could not make a portable copy';
    note.textContent = 'Do not remove this old app. Reload and try again.';
    go.hidden = true;
  } else {
    msg.textContent = 'Craft Rush now lives at craftrush.royashbrook.com';
    note.textContent = 'Open the new home when you are ready.';
    go.addEventListener('click', function (event) {
      event.preventDefault();
      openNewHome();
    });
  }
})();
</script>
</body>
</html>
